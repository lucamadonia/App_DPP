# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables: every .env variant (development, staging, test,
# production, *.local, nested ones such as server/.env). Only the documented
# templates are tracked.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Secrets and signing material (App Store / Play release work). Keystores,
# provisioning profiles and service-account keys never belong in the repo.
*.jks
*.keystore
*.p8
*.p12
*.pem
*.mobileprovision
keystore.properties
google-services.json
GoogleService-Info.plist
service-account*.json

.vercel

# Local Claude Code agent worktrees
.claude/worktrees/

# Office temp files
~$*

# Supabase temp
supabase/.temp/

# Windows artifacts
nul

.vercel

# Capacitor
# The native projects ARE committed — they carry the AndroidManifest permissions,
# App Links config and the generated icons. What must NOT be committed is the
# copied web build: `cap sync` regenerates it from dist/ on every build.
android/app/src/main/assets/public/
android/app/src/main/res/xml/config.xml
ios/App/App/public/
ios/App/App/config.xml
ios/App/Pods/

# Playwright
/tmp/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# AI-generated first-run masters — the shipped derivatives are committed in public/first-run/
resources/first-run/
